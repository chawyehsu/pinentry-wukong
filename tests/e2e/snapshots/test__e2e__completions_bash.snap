                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        pinentry__wukong)
            opts="-v -q -D -T -N -C -M -o -g -h -V --verbose --quiet --debug --config --keyring --no-keyring --display --ttyname --ttytype --lc-ctype --lc-messages --timeout --no-global-grab --ui --help --version serve completions config help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --config)
