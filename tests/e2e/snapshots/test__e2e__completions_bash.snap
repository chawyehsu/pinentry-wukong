        pinentry__subcmd__wukong__subcmd__serve)
            opts="-d -D -T -N -C -M -o -g -v -q -h --debug --display --ttyname --ttytype --lc-ctype --lc-messages --timeout --no-global-grab --ui --no-keychain --verbose --quiet --log-file --help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
